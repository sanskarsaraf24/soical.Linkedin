[{"title":"The Affidavit Search Tax","html":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Casemate – The Affidavit Search Tax</title>\n    <link href=\"https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400&display=swap\" rel=\"stylesheet\">\n    <style>\n        * { box-sizing: border-box; }\n        \n        html, body {\n            width: 1200px;\n            height: 1200px;\n            margin: 0;\n            padding: 0;\n            overflow: hidden;\n        }\n        \n        body {\n            background: linear-gradient(135deg, #0F172A 0%, #1a1f3a 100%);\n            display: flex;\n            flex-direction: column;\n            justify-content: space-between;\n            padding: 80px;\n            font-family: 'Inter', sans-serif;\n        }\n        \n        .kicker {\n            font-family: 'JetBrains Mono', monospace;\n            font-size: 14px;\n            font-weight: 600;\n            letter-spacing: 2px;\n            text-transform: uppercase;\n            color: #F5F3EF;\n            opacity: 0.75;\n            margin: 0 0 40px 0;\n            border-top: 2px solid #F5F3EF;\n            padding-top: 20px;\n        }\n        \n        h1 {\n            font-family: 'Playfair Display', serif;\n            font-size: 85px;\n            line-height: 1.15;\n            margin: 0 0 50px 0;\n            color: #F5F3EF;\n            font-weight: 700;\n            text-align: left;\n        }\n        \n        .accent-word {\n            color: #1D4ED8;\n            font-style: italic;\n        }\n        \n        .divider {\n            width: 60px;\n            height: 3px;\n            background-color: #1D4ED8;\n            margin: 0 0 50px 0;\n        }\n        \n        .content {\n            font-family: 'Inter', sans-serif;\n            font-size: 36px;\n            line-height: 1.5;\n            color: #F5F3EF;\n            margin: 0 0 80px 0;\n            max-width: 100%;\n            font-weight: 400;\n        }\n        \n        .content strong {\n            color: #1D4ED8;\n            font-weight: 600;\n        }\n        \n        .footer-section {\n            display: flex;\n            align-items: center;\n            justify-content: space-between;\n            border-top: 1px solid rgba(245, 243, 239, 0.2);\n            padding-top: 30px;\n        }\n        \n        .brand-info {\n            display: flex;\n            align-items: center;\n            gap: 20px;\n        }\n        \n        .logo {\n            height: 70px;\n            width: auto;\n            object-fit: contain;\n            filter: brightness(1.2);\n        }\n        \n        .brand-name {\n            font-family: 'Playfair Display', serif;\n            font-size: 28px;\n            color: #F5F3EF;\n            font-weight: 700;\n            margin: 0;\n        }\n        \n        .cta-text {\n            font-family: 'Inter', sans-serif;\n            font-size: 32px;\n            color: #1D4ED8;\n            font-weight: 500;\n        }\n        \n        p, li, span, div {\n            font-size: 32px !important;\n            line-height: 1.4;\n        }\n    </style>\n</head>\n<body>\n    <div class=\"top-section\">\n        <div class=\"kicker\">The Hidden Cost of Document Chaos in Litigation</div>\n        \n        <h1>The <span class=\"accent-word\">Affidavit</span> Search Tax</h1>\n        \n        <div class=\"divider\"></div>\n        \n        <div class=\"content\">\n            Your associate just spent <strong>3 hours</strong> finding one affidavit across emails, WhatsApp, and three folders. That's <strong>₹15,000</strong> in billable time spent on document hunting instead of legal strategy.\n        </div>\n    </div>\n    \n    <div class=\"footer-section\">\n        <div class=\"brand-info\">\n            <img src=\"/linkedin/uploads/logos/1778408882556-Casemate_logo_white_no_bg.png\" alt=\"Casemate Logo\" class=\"logo\">\n            <div class=\"brand-name\">Casemate</div>\n        </div>\n        <div class=\"cta-text\">Your most efficient legal associate.</div>\n    </div>\n</body>\n</html>"},{"title":"Inconsistency Derails Arguments","html":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Casemate — Court-Ready Drafting</title>\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n    <link href=\"https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400&display=swap\" rel=\"stylesheet\">\n    <style>\n        * { box-sizing: border-box; }\n        \n        html, body {\n            width: 1200px;\n            height: 1200px;\n            margin: 0;\n            padding: 0;\n            overflow: hidden;\n        }\n        \n        body {\n            background: linear-gradient(135deg, #0F172A 0%, #1a1f3a 100%);\n            display: flex;\n            flex-direction: column;\n            justify-content: space-between;\n            align-items: stretch;\n            padding: 80px;\n            font-family: 'Inter', sans-serif;\n            color: #F5F3EF;\n        }\n        \n        .kicker {\n            font-family: 'JetBrains Mono', monospace;\n            font-size: 14px !important;\n            letter-spacing: 2px;\n            text-transform: uppercase;\n            color: #1D4ED8;\n            margin-bottom: 24px;\n            font-weight: 600;\n        }\n        \n        h1 {\n            font-family: 'Playfair Display', serif;\n            font-size: 95px !important;\n            line-height: 1.15;\n            margin: 0 0 40px 0;\n            color: #F5F3EF;\n            font-weight: 700;\n            letter-spacing: -2px;\n        }\n        \n        .content-wrapper {\n            flex-grow: 1;\n            display: flex;\n            flex-direction: column;\n            justify-content: center;\n        }\n        \n        .divider {\n            width: 60px;\n            height: 3px;\n            background: #1D4ED8;\n            margin: 0 0 32px 0;\n        }\n        \n        .supporting-text {\n            font-family: 'Inter', sans-serif;\n            font-size: 36px !important;\n            line-height: 1.5;\n            color: #F5F3EF;\n            margin: 0;\n            max-width: 900px;\n            font-weight: 400;\n        }\n        \n        .footer {\n            display: flex;\n            align-items: center;\n            justify-content: space-between;\n            margin-top: 40px;\n            padding-top: 32px;\n            border-top: 1px solid rgba(245, 243, 239, 0.2);\n        }\n        \n        .brand-info {\n            display: flex;\n            align-items: center;\n            gap: 20px;\n        }\n        \n        .logo {\n            height: 80px;\n            width: auto;\n            object-fit: contain;\n            filter: brightness(1.2) contrast(1.1);\n        }\n        \n        .brand-name {\n            font-family: 'Playfair Display', serif;\n            font-size: 24px !important;\n            font-weight: 700;\n            color: #F5F3EF;\n            margin: 0;\n        }\n        \n        .brand-tagline {\n            font-family: 'Inter', sans-serif;\n            font-size: 14px !important;\n            color: rgba(245, 243, 239, 0.6);\n            margin: 4px 0 0 0;\n        }\n    </style>\n</head>\n<body>\n    <div class=\"content-wrapper\">\n        <div class=\"kicker\">Why Court-Ready Drafting Isn't Just About Grammar</div>\n        \n        <h1>Inconsistency Derails Arguments</h1>\n        \n        <div class=\"divider\"></div>\n        \n        <p class=\"supporting-text\">A single citation format error in your pleading can collapse your entire procedural argument before you enter the courtroom.</p>\n    </div>\n    \n    <div class=\"footer\">\n        <div class=\"brand-info\">\n            <img src=\"/linkedin/uploads/logos/1778408882556-Casemate_logo_white_no_bg.png\" alt=\"Casemate\" class=\"logo\">\n            <div>\n                <p class=\"brand-name\">Casemate</p>\n                <p class=\"brand-tagline\">Your most efficient legal associate</p>\n            </div>\n        </div>\n    </div>\n</body>\n</html>"},{"title":"The Citation Verification Problem","html":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Casemate - Citation Verification</title>\n    <link href=\"https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;600&display=swap\" rel=\"stylesheet\">\n    <style>\n        * { \n            box-sizing: border-box; \n        }\n        \n        html, body {\n            width: 1200px;\n            height: 1200px;\n            margin: 0;\n            padding: 0;\n            overflow: hidden;\n        }\n        \n        body {\n            background: linear-gradient(135deg, #0F172A 0%, #1a2644 100%);\n            display: flex;\n            flex-direction: column;\n            justify-content: space-between;\n            align-items: flex-start;\n            padding: 80px;\n            font-family: 'Inter', sans-serif;\n        }\n        \n        .container {\n            width: 100%;\n            height: 100%;\n            display: flex;\n            flex-direction: column;\n            justify-content: space-between;\n        }\n        \n        .content-section {\n            display: flex;\n            flex-direction: column;\n            gap: 48px;\n            flex: 1;\n            justify-content: center;\n        }\n        \n        .kicker {\n            font-family: 'JetBrains Mono', monospace;\n            font-size: 14px !important;\n            letter-spacing: 0.15em;\n            text-transform: uppercase;\n            color: #F5F3EF;\n            opacity: 0.75;\n            font-weight: 600;\n            margin: 0;\n            padding: 0;\n            line-height: 1.2;\n            max-width: 600px;\n        }\n        \n        h1 {\n            font-family: 'Playfair Display', serif;\n            font-size: 95px !important;\n            line-height: 1.05;\n            margin: 0;\n            padding: 0;\n            color: #F5F3EF;\n            font-weight: 700;\n            letter-spacing: -0.02em;\n        }\n        \n        .supporting-text {\n            font-family: 'Inter', sans-serif;\n            font-size: 36px !important;\n            line-height: 1.4;\n            color: #F5F3EF;\n            opacity: 0.9;\n            margin: 0;\n            padding: 0;\n            max-width: 700px;\n            font-weight: 400;\n            letter-spacing: -0.01em;\n        }\n        \n        .accent-line {\n            width: 120px;\n            height: 4px;\n            background: #F5F3EF;\n            margin-top: 12px;\n            opacity: 0.6;\n        }\n        \n        .footer {\n            display: flex;\n            align-items: center;\n            justify-content: space-between;\n            width: 100%;\n            border-top: 1px solid rgba(245, 243, 239, 0.15);\n            padding-top: 48px;\n        }\n        \n        .logo-branding {\n            display: flex;\n            align-items: center;\n            gap: 24px;\n        }\n        \n        .logo-branding img {\n            height: 80px;\n            width: auto;\n            object-fit: contain;\n            filter: brightness(1.1);\n        }\n        \n        .brand-name {\n            font-family: 'Playfair Display', serif;\n            font-size: 28px !important;\n            color: #F5F3EF;\n            font-weight: 600;\n            margin: 0;\n            padding: 0;\n            letter-spacing: -0.01em;\n        }\n        \n        .tagline {\n            font-family: 'Inter', sans-serif;\n            font-size: 16px !important;\n            color: #F5F3EF;\n            opacity: 0.6;\n            margin: 0;\n            padding: 0;\n        }\n        \n        .empty-spacer {\n            flex: 1;\n        }\n    </style>\n</head>\n<body>\n    <div class=\"container\">\n        <div class=\"content-section\">\n            <div class=\"kicker\">\n                The real bottleneck in legal research isn't finding cases—it's verifying them\n            </div>\n            \n            <h1>The Citation Verification Problem</h1>\n            \n            <p class=\"supporting-text\">You found the perfect precedent. But is it still good law?</p>\n            \n            <div class=\"accent-line\"></div>\n        </div>\n        \n        <div class=\"empty-spacer\"></div>\n        \n        <div class=\"footer\">\n            <div class=\"logo-branding\">\n                <img src=\"/linkedin/uploads/logos/1778408882556-Casemate_logo_white_no_bg.png\" alt=\"Casemate Logo\">\n                <div>\n                    <p class=\"brand-name\">Casemate</p>\n                    <p class=\"tagline\">Your most efficient legal associate</p>\n                </div>\n            </div>\n        </div>\n    </div>\n</body>\n</html>"}]
